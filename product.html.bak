<main id="main">
  <!-- Marketing-collection banner (Hasli, Rose Collection, etc.) — hidden
       unless the page was reached via ?collection= and that collection has
       banner data; product-category pages (?cat=) never show this. The
       collection name + tagline are baked into the banner image itself. -->
  <section class="hidden aspect-[16/5] w-full overflow-hidden" data-collection-banner>
    <img class="h-full w-full object-cover" data-collection-banner-img alt="">
  </section>

  <nav class="mx-auto w-full max-w-wrapper px-3 md:px-4 flex flex-wrap items-center gap-1.5 py-2 text-[13px] text-muted border-b border-line" aria-label="Breadcrumb">
      <a class="transition-colors hover:text-accent" href="index.html">Home</a>
      <span class="opacity-50">/</span>
      <a class="transition-colors hover:text-accent" href="collection.html">Collections</a>
      <span class="opacity-50">/</span>
      <span class="text-heading" aria-current="page" data-collection-crumb>Necklace Sets</span>
  </nav>

  <div class="mx-auto w-full max-w-wrapper px-3 md:px-4">
    <header class="pb-6 pt-2 text-center md:pb-[30px]">
      <h1 class="text-[20px] uppercase tracking-[0.5px] md:text-[26px] mb-2.5" data-collection-title>Necklace Sets</h1>
      <p class="mx-auto max-w-[70ch] text-[13.5px] text-muted" data-collection-desc>Handcrafted necklace sets in 24Kt gold plating, finished with anti-tarnish protection. 45 products.</p>
    </header>
  </div>

