APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# redis, not database: on Hostinger the DB is a remote MySQL host with
# ~700ms-1.3s round-trip latency, so a database-backed session added that
# tax to literally every request. Redis (config/database.php's 'default'
# connection) is already used for CACHE_STORE and lives on 127.0.0.1 — near
# zero added latency. Switching this resets everyone's session once.
SESSION_DRIVER=redis
SESSION_LIFETIME=2628000
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" only writes emails to storage/logs — nothing is sent. On Hostinger use
# its SMTP with a mailbox created in hPanel (Emails), and send FROM that same
# mailbox, or Hostinger rejects the message:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_USERNAME=no-reply@yourdomain.com
#   MAIL_PASSWORD=the-mailbox-password
#   MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
# Or send through a Gmail account. MAIL_PASSWORD must be a 16-character Google
# "App password" (Google Account > Security > 2-Step Verification > App
# passwords), not the normal Gmail password, and the FROM address must be
# that same Gmail address:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=465
#   MAIL_USERNAME=your-account@gmail.com
#   MAIL_PASSWORD=the-app-password
#   MAIL_FROM_ADDRESS="your-account@gmail.com"
#   MAIL_FROM_NAME="Estele"
# then run: php artisan config:clear
# and check it with: php artisan mail:test your-account@gmail.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Leave blank to use flat-rate shipping (default) — ShippingManager falls
# back automatically when these aren't set or the API is unreachable.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=

# Shiprocket Fastrr Checkout (express checkout iframe on product pages)
FASTRR_API_KEY=
FASTRR_API_SECRET=
FASTRR_BASE_URL=https://checkout-api.shiprocket.com
FASTRR_CATALOG_TOKEN=
# Only change these if Shiprocket's API docs name a different token endpoint/response key
FASTRR_TOKEN_PATH=/api/v1/access-token
FASTRR_TOKEN_KEY=token

# Leave blank to stay COD-only — the online-payment radio on checkout stays
# hidden until these are set AND the payment_provider setting is switched to
# "razorpay" (PaymentManager checks both before enabling it).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Leave blank to stay on the default LogOtpGateway (mobile-OTP login stays
# fully functional, the code just gets logged instead of texted) — set these
# to switch OtpManager over to real SMS via VAS Multimedia, the same gateway
# already used by the sibling ZappDeal project (values there are still blank
# too as of writing, so this is a "port the integration, not yet the keys").
VAS_SMS_API_KEY=
VAS_SMS_SENDER=TCONGS
VAS_SMS_ENTITY_ID=
VAS_SMS_TEMPLATE_ID=
VAS_SMS_MESSAGE_TEMPLATE="Your Estele OTP is %s"
SMS_CA_BUNDLE=

# Leave blank to stay on the default LogWhatsAppGateway (vendor/admin/customer
# old-jewellery notifications stay fully functional, messages just get logged
# instead of sent over WhatsApp). Set WHATSAPP_PROVIDER=cloud_api with the
# Meta Cloud API graph URL, permanent access token and phone-number-id to
# send for real (App\Services\WhatsApp\CloudApiWhatsAppGateway).
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_FROM_NUMBER=

# Leave blank to disable error tracking entirely (default — the SDK is
# installed and wired into bootstrap/app.php but never dials out with no
# DSN). Get a free DSN from a Sentry account (sentry.io) to activate.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"

# Read only by database/seeders/DatabaseSeeder.php to create the first
# super_admin login. Leave blank to skip admin creation on `db:seed` — the
# seeder never falls back to a built-in email/password. Set these locally
# (never commit real values) before seeding a fresh database.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
